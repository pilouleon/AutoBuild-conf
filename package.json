{
  "name": "autobuild-conf",
  "productName": "AutoBuild",
  "version": "0.3.0",
  "description": "Maquette sur-mesure générée pendant le rendez-vous prospect",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "setup": "npm install && npm --prefix templates/socle install",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && npm --prefix templates/socle run check",
    "test": "vitest run",
    "demo:headless": "tsx --tsconfig tsconfig.node.json scripts/demo-headless.ts",
    "test:app": "npm run build && node scripts/e2e-electron.cjs",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "test:audio": "npm run build && node scripts/e2e-audio.cjs",
    "docs": "tsx --tsconfig tsconfig.node.json scripts/gen-docs.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@anthropic-ai/sdk": "^1.8.0",
    "@google/genai": "^3.2.0",
    "node-html-parser": "^9.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "author": "AutoBuild"
}
